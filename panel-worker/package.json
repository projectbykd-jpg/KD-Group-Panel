{
  "name": "panel-worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build:ui": "node scripts/build-ui.mjs",
    "predeploy": "node scripts/build-ui.mjs",
    "deploy": "wrangler deploy",
    "dev": "node scripts/build-ui.mjs && wrangler dev",
    "start": "node scripts/build-ui.mjs && wrangler dev",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p test",
    "cf-typegen": "wrangler types",
    "check": "npm run typecheck && npm test && npm run build:ui && node scripts/check-ui-names.mjs"
  },
  "devDependencies": {
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fortawesome/fontawesome-free": "6.4.0",
    "@types/node": "^26.5.0",
    "animejs": "3.2.2",
    "flatpickr": "4.6.13",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.5.2",
    "vitest": "~4.1.0",
    "wrangler": "^4.129.1"
  },
  "dependencies": {
    "@libsql/client": "^0.15.15"
  }
}
